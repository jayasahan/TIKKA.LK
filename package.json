{
  "name": "tikka",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "description": "TIKKA MVP monorepo.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm --workspace apps/platform start",
    "dev:react": "npm --workspace apps/platform run dev:react",
    "build:react": "npm --workspace apps/platform run build:react",
    "test:react": "npm --workspace apps/platform run test:react",
    "typecheck": "npm --workspace apps/platform run typecheck",
    "lint": "npm --workspace apps/platform run lint",
    "test": "npm --workspace apps/platform test",
    "build": "npm --workspace apps/platform run build",
    "db:migrate": "npm --workspace apps/platform run db:migrate",
    "db:seed": "npm --workspace apps/platform run db:seed"
  },
  "license": "UNLICENSED"
}
