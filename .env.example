TIKKA_ADMIN_EMAIL=admin@example.com
TIKKA_ADMIN_PASSWORD=change-me
TIKKA_DB_PATH=storage/tikka-db.json
TIKKA_STORAGE_DRIVER=postgres
DATABASE_URL=postgresql://user:password@localhost:5432/tikka
PGSSLMODE=require
TIKKA_LOGIN_LIMIT_WINDOW_MS=900000
TIKKA_LOGIN_LIMIT_MAX_FAILURES=5
PORT=3000
NODE_ENV=development
